UPLOAD_DIR=./uploads (optionnel, défaut auto)
# ─────────────────────────────────────────────────────────────────────────────
# Eco-Formalités — Variables d'environnement
# Copiez ce fichier en ".env" et remplissez les valeurs.
# Ne commitez JAMAIS le fichier .env dans git.
# ─────────────────────────────────────────────────────────────────────────────

# Serveur
PORT=3001

# ── Email (Outlook SMTP) ──────────────────────────────────────────────────────
# Ton adresse Outlook / Microsoft 365
SMTP_EMAIL=ton-adresse@outlook.fr
# Mot de passe d'application (compte Microsoft → Sécurité → Mots de passe d'app)
SMTP_PASSWORD=ton_mot_de_passe_application
# Nom affiché dans les emails
SMTP_FROM_NAME=Eco-Formalités
# Host SMTP : outlook.fr/hotmail = smtp-mail.outlook.com | Microsoft 365 = smtp.office365.com
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587

# ── Sécurité (Phase 2) ────────────────────────────────────────────────────────
# Clé secrète pour les JWT (générez avec: openssl rand -hex 64)
# JWT_SECRET=votre_secret_tres_long_et_aleatoire

# ── Stockage fichiers (Phase 2 — GED) ─────────────────────────────────────────
# Option A : Stockage local (par défaut)
# UPLOAD_DIR=./uploads

# Option B : MinIO (S3-compatible, pour VPS)
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=eco-formalites
